APP_ENV=development
DATABASE_URL=postgresql+asyncpg://aer:aer@localhost:5433/aer

# Local keeps the role-switching demo. Production must use password mode and
# configure both secrets in its deployment dashboard, never in source control.
AUTH_MODE=demo
AUTH_SECRET_KEY=
# Example production format: {"student-a1":"pbkdf2_sha256$..."}
AUTH_USERS_JSON=
AUTH_TOKEN_TTL_MINUTES=480

AI_MODE=fake
AI_HEALTH_CACHE_SECONDS=45
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# OCR has its own Gemini Vision key and model. It never reuses GEMINI_API_KEY.
# Image and scanned-PDF bytes leave the server when this provider is selected.
DOCUMENT_OCR_PROVIDER=gemini_vision
GEMINI_VISION_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENCY=1

RAG_TOP_K=8
RAG_CONTEXT_CHUNKS=5
RAG_MIN_SCORE=0.15
# VietOCR downloads this approved pretrained weight once when it is missing,
# saves it locally, and then reuses it without another network request.
VIETOCR_MODEL_NAME=vgg_transformer
VIETOCR_WEIGHTS_PATH=data/models/vietocr/vgg_transformer.pth
VIETOCR_DEVICE=cpu
VIETOCR_ALLOW_WEIGHT_DOWNLOAD=true
VIETOCR_WEIGHTS_URL=https://vocr.vn/data/vietocr/vgg_transformer.pth
VIETOCR_DOWNLOAD_TIMEOUT_SECONDS=300
PROMPT_VERSION=referee-v3-structured-exceptions
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost
